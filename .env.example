# Revision 1 is a static Jekyll site. It does not read environment variables.
# Set these public fields in _config.yml instead:
# supabase_url: "https://YOUR_PROJECT_REF.supabase.co"
# supabase_publishable_key: "YOUR_PUBLISHABLE_KEY"
# Never paste a service_role key, secret key, or Google client secret into site files.
