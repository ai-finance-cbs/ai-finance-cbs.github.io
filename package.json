{
  "name": "ai-finance-cbs-checks",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "./tools/build.sh",
    "dev": "./tools/dev.sh",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:e2e": "playwright test",
    "check": "npm run build && npm test && npm run test:e2e"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "embedded-postgres": "17.10.0-beta.17",
    "fflate": "0.8.3"
  },
  "allowScripts": {
    "@embedded-postgres/darwin-arm64@17.10.0-beta.17": true
  }
}
